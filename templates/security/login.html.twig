<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in · Coreware Migration</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/logo-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/logo-256.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    {{ importmap('app') }}
</head>
<body class="min-h-screen grid place-items-center bg-slate-50 px-4 antialiased">
<main class="w-full max-w-sm" style="margin:0;min-height:0">
    <div class="brand justify-center mb-8" style="color:var(--navy)"><img class="brand-logo large" src="{{ asset('images/logo-256.png') }}" alt="" width="56" height="56"><span>Coreware<small style="color:var(--muted)">migration control</small></span></div>
    <form method="post" action="{{ path('app_login') }}" class="bg-white border border-slate-200 rounded-xl shadow-sm p-7 space-y-4">
        <h1 class="text-2xl">Sign in</h1>
        {% if error %}
            <p class="text-sm rounded-md px-3 py-2" style="background:var(--red-bg);color:var(--red)">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
        {% endif %}
        <label class="block text-sm font-semibold">Username
            <input type="text" name="_username" value="{{ last_username }}" autocomplete="username" required autofocus class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-normal">
        </label>
        <label class="block text-sm font-semibold">Password
            <input type="password" name="_password" autocomplete="current-password" required class="mt-1 w-full rounded-md border border-slate-300 px-3 py-2 font-normal">
        </label>
        <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
        <button type="submit" class="button primary w-full">Sign in</button>
    </form>
</main>
</body>
</html>
