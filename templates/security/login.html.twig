{% extends '_signed_out_layout.html.twig' %}

{% block title %}Sign in{% endblock %}

{% block stylesheets %}
<style>
    /* Inline field errors (field-validation controller), in place of the browser's bubbles */
    .login-page input[aria-invalid="true"]{border-color:#ff6b7f;box-shadow:0 0 0 3px rgba(255,107,127,.18)}
    .login-page .field-error{display:flex;align-items:center;gap:6px;margin-top:7px;font-size:12.5px;font-weight:500;color:#ff9aa8;animation:field-error-in .22s ease-out}
    .login-page .field-error svg{flex-shrink:0}
    @keyframes field-error-in{from{opacity:0;transform:translateY(-4px)}}
    @media (prefers-reduced-motion:reduce){.login-page .field-error{animation:none}}
</style>
{% endblock %}

{# The mouse wheel zooms out from the Earth to the solar system (login-globe controller); the marker is where
   the app's timezone is. #}
{% block globe_attributes %}
    {%- set location = app_timezone_location() -%}
    data-login-globe-zoomable-value="true" data-login-globe-hud-value="true"
    {%- if location %} data-login-globe-marker-value="{{ [location.lon, location.lat]|json_encode }}" data-login-globe-marker-label-value="{{ location.city|upper }}"{% endif %}
{%- endblock %}

{# Live clock in the app's timezone (APP_TIMEZONE), e.g. "MANILA (UTC+8)"; the clock controller keeps it ticking. #}
{% block header_status %}
    {% set zone = 'now'|date('e') %}
    {% set offset = 'now'|date('P')|replace({':00': ''})|replace({'+0': '+', '-0': '-'}) %}
    <div class="console-clock" data-controller="clock" data-clock-time-zone-value="{{ zone }}" aria-hidden="true">
        <b data-clock-target="time">{{ 'now'|date('H:i:s') }}</b>
        <span><span data-clock-target="date">{{ 'now'|date('D d M Y')|upper }}</span> · {{ zone|split('/')|last|replace({'_': ' '})|upper }} (UTC{{ offset }})</span>
    </div>
{% endblock %}

{% block body %}
<main class="flex-1 flex items-center justify-start px-6 sm:px-10 lg:px-20 py-10" style="margin:0;min-height:0">
    <div class="w-full max-w-xl content-column">
        {% set status = system_lock() %}
        {% for message in app.flashes('system_lock') %}
            <p class="max-w-sm text-sm rounded-md px-3 py-2 mb-4" role="status" style="background:#12305e;color:#cfe0ff">{{ message }}</p>
        {% endfor %}
        {% if status.locked %}
        {# The lock replaces the sign-in form; only the super user can lift it. #}
        {{ include('security/_system_locked_badge.html.twig') }}
        <h1 class="text-4xl sm:text-5xl mb-4" style="color:#fff;line-height:1.1">Data migration<br>is locked</h1>
        <div class="w-full max-w-sm space-y-4">
            <p class="text-sm leading-6" style="color:#87a4d4">Sign-in is closed for every account until the super user unlocks the system.</p>
            {% if status.reason and not status.tampered %}
                <p class="text-xs rounded-md px-3 py-2" style="background:#0b1a36cc;color:#8ea7cf;border:1px solid #24436f">Reason: {{ status.reason }}</p>
            {% endif %}
            <a href="{{ path('app_system_unlock') }}" class="button primary w-full h-12" style="margin:8px 0 0">Unlock</a>
        </div>
        {% else %}
        <div class="console-kicker" aria-hidden="true">&gt; CORE ACCOUNT MIGRATION <span>// CONSOLE</span></div>
        <h1 class="text-4xl sm:text-5xl mb-4" style="color:#fff;line-height:1.1">Sign in to<br>data migration</h1>
        <form autocomplete="off" method="post" action="{{ path('app_login') }}" class="w-full max-w-sm space-y-4" data-turbo="false" data-controller="field-validation rocket-swipe" data-action="field-validation#validate page-loader#show rocket-swipe#depart" data-rocket-swipe-to-param="app">
            <div class="text-sm" style="color:#87a4d4">Use your operations account.</div>
            {% if error %}
                <p class="text-sm rounded-md px-3 py-2" role="alert" style="background:var(--red-bg);color:var(--red)">{{ error }}</p>
            {% elseif expired %}
                <p class="text-sm rounded-md px-3 py-2" role="status" style="background:#12305e;color:#cfe0ff">Your session ended for security. Sign in again to continue.</p>
            {% endif %}
            <label class="block text-sm font-semibold" style="color:#dbe7ff">Username
                <input type="text" name="_username" value="{{ last_username }}" autocomplete="off" maxlength="180" required autofocus class="mt-1.5 w-full rounded-md border border-[#2d4770] bg-[#0b1a36]/80 text-white px-3 py-2.5 font-normal focus:outline-none focus:border-[#5c9bff] focus:ring-2 focus:ring-[#5c9bff]/30">
            </label>
            <label class="block text-sm font-semibold pb-2" style="color:#dbe7ff">Password
                <input type="password" name="_password" autocomplete="off" maxlength="4096" required class="mt-1.5 w-full rounded-md border border-[#2d4770] bg-[#0b1a36]/80 text-white px-3 py-2.5 font-normal focus:outline-none focus:border-[#5c9bff] focus:ring-2 focus:ring-[#5c9bff]/30">
            </label>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="button primary w-full h-12" style="margin:8px 0 0">Sign in</button>
            <span class="block text-xs mt-2" style="color:#8ea7cf">Forgot your password or locked out? Contact your user administrator.</span>
        </form>
        <div class="w-full max-w-sm mt-5 pt-4 flex items-center gap-3 border-t text-xs" style="border-color:#24436f;color:#8ea7cf">
            {% if status.scheduled %}
                <span class="lock-countdown" style="color:#f5c98a">Access ends on {{ status.locksAt|date('M j, Y') }} · {{ status.daysLeft }} day{{ status.daysLeft == 1 ? '' : 's' }} left</span>
            {% endif %}
            <a href="{{ path('app_system_lock') }}" class="ml-auto inline-flex items-center gap-1.5 rounded-md px-2.5 py-1.5 font-semibold" style="color:#dbe7ff;border:1px solid #2d4770" data-turbo="false">
                <svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 8 0v4"/></svg>
                Lockout
            </a>
        </div>
        {% endif %}
    </div>
</main>
<div class="zoom-hint" aria-hidden="true">
    <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="7" y="3" width="10" height="18" rx="5"/><path d="M12 7v3"/></svg>
    Scroll to explore the solar system
</div>
{# Hidden for now; remove "hidden" to show the safeguards row again. #}
<section class="login-safeguards relative z-[1] px-6 sm:px-10 lg:px-20 pb-8" aria-label="Safeguards" hidden>
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 border-t pt-6 text-sm" style="border-color:#24436f">
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Dual-control approval</b><span class="block text-xs leading-5" style="color:#8ea7cf">Every account replacement and rollback is approved by a second authorized user before core records change.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.6"/><path d="M21 5l-9 9-3-3"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Verified against live core data</b><span class="block text-xs leading-5" style="color:#8ea7cf">Mappings are validated on upload and re-checked under row locks immediately before each change is committed.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Complete audit trail</b><span class="block text-xs leading-5" style="color:#8ea7cf">Uploads, approvals, replacements and rollbacks are recorded with the user and time of each action.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.4 5.4A9.5 9.5 0 0 1 12 5c4 0 7.3 2.3 9 7-.6 1.5-1.4 2.8-2.4 3.8M6.6 6.6C4.9 7.8 3.7 9.6 3 12c1.7 4.7 5 7 9 7 1.6 0 3-.4 4.3-1"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Card data protection</b><span class="block text-xs leading-5" style="color:#8ea7cf">Card numbers stay tokenized in core and are only ever displayed masked.</span></div></li>
    </ul>
</section>
{% endblock %}
