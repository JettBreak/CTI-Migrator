<!DOCTYPE html>
<html lang="en" class="page-loading" data-controller="page-loader" data-page-loader-wait-for-value="login-globe:ready">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Sign in · Coreware Migration</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/logo-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/logo-256.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    {{ importmap('app') }}
</head>
<body class="login-page min-h-screen flex flex-col antialiased">
<style>
    .login-page{background:
        radial-gradient(ellipse 45% 55% at 88% 18%,rgba(124,77,219,.45),transparent 70%),
        radial-gradient(ellipse 40% 50% at 62% 88%,rgba(48,104,219,.45),transparent 70%),
        radial-gradient(ellipse 30% 35% at 98% 85%,rgba(245,154,35,.18),transparent 70%),
        radial-gradient(ellipse 35% 45% at 8% 20%,rgba(48,104,219,.28),transparent 70%),
        radial-gradient(ellipse 30% 40% at 25% 95%,rgba(124,77,219,.25),transparent 70%),
        radial-gradient(circle at 75% 50%,#0c1f45,#050b1c 80%) fixed}
    /* Header and footer sit directly on the space scene, with light text */
    .login-bar{position:relative;z-index:1;border:0;background:transparent}
    header.login-bar{height:auto}
    /* Inline field errors (field-validation controller), in place of the browser's bubbles */
    .login-page input[aria-invalid="true"]{border-color:#ff6b7f;box-shadow:0 0 0 3px rgba(255,107,127,.18)}
    .login-page .field-error{display:flex;align-items:center;gap:6px;margin-top:7px;font-size:12.5px;font-weight:500;color:#ff9aa8;animation:field-error-in .22s ease-out}
    .login-page .field-error svg{flex-shrink:0}
    @keyframes field-error-in{from{opacity:0;transform:translateY(-4px)}}
    @media (prefers-reduced-motion:reduce){.login-page .field-error{animation:none}}
</style>
<div class="page-loader solid">{% include '_dino_loading.html.twig' with {active: true, label: 'Loading resources…'} %}</div>
<canvas data-controller="login-globe" data-login-globe-land-value="{{ asset('data/land-110m.json') }}" aria-hidden="true" class="max-md:hidden fixed inset-0 w-full h-full -z-10 pointer-events-none"></canvas>
<header class="login-bar py-5 flex items-center gap-3.5 sm:gap-5 px-6 sm:px-10">
    <img src="{{ asset('images/logo-256.png') }}" alt="" width="60" height="60" class="w-[42px] h-[42px] sm:w-[60px] sm:h-[60px] shrink-0" style="filter:drop-shadow(0 0 12px rgba(245,154,35,.55))">
    <span class="text-lg sm:text-[33px] leading-tight" style="font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-.5px;color:#fff;text-shadow:0 0 22px rgba(120,170,255,.45)">Coreware Technologies Inc.</span>
    <span class="ml-auto inline-flex items-center gap-2 text-xs font-semibold rounded-md px-2.5 py-1" style="background:var(--green-bg);color:var(--green);border:1px solid rgba(22,135,101,.2)"><span class="live-dot" style="margin:0"></span>Secure environment</span>
</header>
<main class="flex-1 flex items-center justify-start px-6 sm:px-10 lg:px-20 py-10" style="margin:0;min-height:0">
    <div class="w-full max-w-xl pl-40">
        <h1 class="text-4xl sm:text-5xl mb-4" style="color:#fff;line-height:1.1">Sign in to<br>migration control</h1>
        <form autocomplete="off" method="post" action="{{ path('app_login') }}" class="w-full max-w-sm space-y-4" data-turbo="false" data-controller="field-validation" data-action="field-validation#validate page-loader#show">
            <div class="text-sm" style="color:#87a4d4">Use your operations account.</div>
            {% if error %}
                <p class="text-sm rounded-md px-3 py-2" style="background:var(--red-bg);color:var(--red)">{{ error.messageKey|trans(error.messageData, 'security') }}</p>
            {% endif %}
            <label class="block text-sm font-semibold" style="color:#dbe7ff">Username
                <input type="text" name="_username" value="{{ last_username }}" autocomplete="off" required autofocus class="mt-1.5 w-full rounded-md border border-[#2d4770] bg-[#0b1a36]/80 text-white px-3 py-2.5 font-normal focus:outline-none focus:border-[#5c9bff] focus:ring-2 focus:ring-[#5c9bff]/30">
            </label>
            <label class="block text-sm font-semibold pb-2" style="color:#dbe7ff">Password
                <input type="password" name="_password" autocomplete="off" required class="mt-1.5 w-full rounded-md border border-[#2d4770] bg-[#0b1a36]/80 text-white px-3 py-2.5 font-normal focus:outline-none focus:border-[#5c9bff] focus:ring-2 focus:ring-[#5c9bff]/30">
            </label>
            <input type="hidden" name="_csrf_token" data-controller="csrf-protection" value="{{ csrf_token('authenticate') }}">
            <button type="submit" class="button primary w-full h-12" style="margin:8px 0 0">Sign in</button>
            <span class="block text-xs mt-2" style="color:#8ea7cf">Forgot your password? Contact your system administrator.</span>
        </form>
    </div>
</main>
<section class="login-safeguards relative z-[1] px-6 sm:px-10 lg:px-20 pb-8" aria-label="Safeguards">
    <ul class="grid gap-6 sm:grid-cols-2 lg:grid-cols-4 lg:gap-0 border-t pt-6 text-sm" style="border-color:#24436f">
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z"/><path d="M9 12l2 2 4-4"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Dual-control approval</b><span class="block text-xs leading-5" style="color:#8ea7cf">Every account replacement and rollback is approved by a second authorized user before core records change.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M21 12a9 9 0 1 1-6.2-8.6"/><path d="M21 5l-9 9-3-3"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Verified against live core data</b><span class="block text-xs leading-5" style="color:#8ea7cf">Mappings are validated on upload and re-checked under row locks immediately before each change is committed.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 12a9 9 0 1 0 3-6.7L3 8"/><path d="M3 3v5h5"/><path d="M12 7v5l3 2"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Complete audit trail</b><span class="block text-xs leading-5" style="color:#8ea7cf">Uploads, approvals, replacements and rollbacks are recorded with the user and time of each action.</span></div></li>
        <li class="flex items-start gap-3 lg:px-6 lg:first:pl-0 lg:border-l lg:first:border-l-0" style="border-color:#24436f"><svg class="mt-0.5 shrink-0" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#8fc0ff" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M3 3l18 18"/><path d="M10.6 10.6a2 2 0 0 0 2.8 2.8"/><path d="M9.4 5.4A9.5 9.5 0 0 1 12 5c4 0 7.3 2.3 9 7-.6 1.5-1.4 2.8-2.4 3.8M6.6 6.6C4.9 7.8 3.7 9.6 3 12c1.7 4.7 5 7 9 7 1.6 0 3-.4 4.3-1"/></svg><div><b class="block font-semibold" style="color:#e6eeff">Card data protection</b><span class="block text-xs leading-5" style="color:#8ea7cf">Card numbers stay tokenized in core and are only ever displayed masked.</span></div></li>
    </ul>
</section>
<footer class="login-bar w-full px-6 sm:px-10 py-4 flex flex-col sm:flex-row gap-1 sm:items-center text-xs" style="color:#8ea7cf">
    <span>© {{ 'now'|date('Y') }} Coreware Technologies Inc. All rights reserved.</span>
    <span class="sm:ml-auto">Authorized personnel only · activity is logged · v1.0</span>
</footer>
</body>
</html>
