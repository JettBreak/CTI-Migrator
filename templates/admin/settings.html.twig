{% extends 'base.html.twig' %}

{% block title %}Settings · Coreware{% endblock %}
{% block crumb %}Settings{% endblock %}

{% block body %}
<section class="page-head compact">
    <div>
        <span class="eyebrow">ADMINISTRATION</span>
        <h1>Settings</h1>
        <p>App-wide settings: they apply to everyone, on every page, including the sign-in page. Each change is recorded in the account audit trail.</p>
    </div>
</section>

<section class="panel pad">
    {{ form_start(form, {attr: {autocomplete: 'off', class: 'settings-form'}}) }}
        <span class="eyebrow">THEME</span>
        <h2>Theme</h2>
        <p class="muted" style="margin:6px 0 0">The look of every page, including the sign-in page. Each user still picks light or dark in the header.</p>
        {{ form_errors(form.theme) }}
        <div class="loader-options">
            {% for choice in form.theme %}
                {% set theme = themes|filter(t => t.value == choice.vars.value)|first %}
                <label class="loader-option">
                    <span class="loader-option-head">
                        {{ form_widget(choice) }}
                        <span><b>{{ theme.label }}</b><small class="muted">{{ theme.description }}</small></span>
                        {% if theme == currentTheme %}<span class="tag success current">In use</span>{% endif %}
                    </span>
                    <span class="theme-swatch" data-app-theme="{{ theme.value }}" aria-hidden="true"></span>
                </label>
            {% endfor %}
        </div>

        <span class="eyebrow settings-next">LOADING ANIMATION</span>
        <h2>Loading animation</h2>
        <p class="muted" style="margin:6px 0 0">Shown while pages, tables and exports load.</p>
        {{ form_errors(form.loadingAnimation) }}
        <div class="loader-options">
            {% for choice in form.loadingAnimation %}
                {% set animation = animations|filter(a => a.value == choice.vars.value)|first %}
                <label class="loader-option">
                    <span class="loader-option-head">
                        {{ form_widget(choice) }}
                        <span><b>{{ animation.label }}</b><small class="muted">{{ animation.description }}</small></span>
                        {% if not currentTheme.allows(animation) %}<span class="tag neutral current">Not in the {{ currentTheme.label }} theme</span>
                        {% elseif animation == loading_animation() %}<span class="tag success current">In use</span>{% endif %}
                    </span>
                    {{ include('_loading.html.twig', {active: true, animation: animation, label: 'Loading…'}) }}
                </label>
            {% endfor %}
        </div>
        <div class="review-actions">
            <button type="submit" class="button primary">Save</button>
        </div>
    {{ form_end(form) }}
</section>
{% endblock %}
