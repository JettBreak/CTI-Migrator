{% extends 'base.html.twig' %}

{% block title %}{{ user.username }} · Users · Coreware{% endblock %}
{% block crumb %}Users <b>/</b> {{ user.username }}{% endblock %}

{% set mine = user.username == app.user.userIdentifier %}
{% set when = 'M j, Y H:i' %}

{% block body %}
<section class="page-head compact">
    <div><span class="eyebrow">ADMINISTRATION · USER</span></div>
    <a class="back-link" href="{{ path('app_admin_users') }}">← All users</a>
</section>

{{ include('admin/_credential.html.twig') }}

<div class="user-layout">
    {# Who the account is and how it stands #}
    <aside class="panel user-rail">
        <div class="user-avatar" aria-hidden="true">{{ user.displayName|split(' ')|map(p => p|first)|join|slice(0, 2)|upper }}</div>
        <h1>{{ user.displayName }}</h1>
        <p class="user-id"><code>{{ user.username }}</code><span>{{ user.role.label }}</span></p>
        <div class="tag-row">{{ include('admin/_status.html.twig') }}</div>

        {% if user.active %}
            {% set age = policy.passwordAgeDays(user) %}
            {% set max = policy.passwordMaxAgeDays %}
            <div class="password-age {{ user.mustChangePassword or age >= max ? 'expired' : (age >= max * 0.75 ? 'ageing') }}">
                <div class="password-age-head">
                    <span>Password age</span>
                    <b>{{ user.mustChangePassword ? 'Temporary' : age ~ ' of ' ~ max ~ ' days' }}</b>
                </div>
                <div class="password-age-bar"><span style="width:{{ user.mustChangePassword ? 100 : min(100, (age / max * 100)|round) }}%"></span></div>
                <small>
                    {% if user.mustChangePassword %}Must be changed at the next sign-in.
                    {% elseif age >= max %}Expired: must be changed at the next sign-in.
                    {% else %}Expires in {{ max - age }} day{{ max - age == 1 ? '' : 's' }}.{% endif %}
                </small>
            </div>
        {% endif %}

        <dl class="rail-facts">
            <div><dt>Last sign-in</dt><dd>{{ user.lastLoginAt ? user.lastLoginAt|date(when) : 'Never' }}{% if user.lastLoginIp %}<small>from {{ user.lastLoginIp }}</small>{% endif %}</dd></div>
            {% if user.previousLoginAt %}<div><dt>Previous sign-in</dt><dd>{{ user.previousLoginAt|date(when) }}{% if user.previousLoginIp %}<small>from {{ user.previousLoginIp }}</small>{% endif %}</dd></div>{% endif %}
            <div><dt>Password changed</dt><dd>{{ user.passwordChangedAt|date(when) }}</dd></div>
            <div><dt>Failed sign-ins in a row</dt><dd>{{ user.failedLoginCount }} of {{ policy.maxFailedLogins }}{% if user.locked %}<small>locked since {{ user.lockedAt|date(when) }}</small>{% endif %}</dd></div>
            <div><dt>Created</dt><dd>{{ user.createdAt|date(when) }}<small>by {{ user.createdBy }}</small></dd></div>
            {% if not user.active %}<div><dt>Disabled</dt><dd>{{ user.deactivatedAt ? user.deactivatedAt|date(when) }}<small>by {{ user.deactivatedBy }}</small></dd></div>{% endif %}
        </dl>
    </aside>

    <div class="user-main">
        {% if pending %}
        <section class="panel pending-change" aria-label="Change waiting for approval">
            <svg class="pending-icon" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <div>
                <span class="eyebrow">WAITING FOR APPROVAL</span>
                <b>{{ pending.describe }}</b>
                <small class="block">Requested by {{ pending.requestedBy }} on {{ pending.requestedAt|date(when) }} · {{ pending.reason }}</small>
                {{ include('admin/_request_actions.html.twig', {change: pending}) }}
            </div>
        </section>
        {% endif %}

        <section class="panel account-actions" data-controller="tabs" data-tabs-closable-value="true">
            <span class="eyebrow">CHANGE THIS ACCOUNT</span>
            {% if mine %}
                <p class="muted">You cannot change your own account; another administrator has to. Use <a href="{{ path('app_account_password') }}">Change password</a> for your password.</p>
            {% elseif pending %}
                <p class="muted">A change is already waiting for approval. Only one change per account can be pending.</p>
            {% else %}
                <p class="muted">Each change is a request: another administrator has to approve it before it takes effect. The reason is kept in the audit trail.</p>
                <div class="action-tiles" role="tablist">
                    {% if user.locked %}
                        <button type="button" class="action-tile" role="tab" data-tabs-target="tab" data-action="tabs#select">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="4" y="11" width="16" height="10" rx="2"/><path d="M8 11V7a4 4 0 0 1 7.5-2"/></svg>
                            <b>Unlock</b><small>Takes effect at once</small>
                        </button>
                    {% endif %}
                    {% if user.active %}
                        <button type="button" class="action-tile" role="tab" data-tabs-target="tab" data-action="tabs#select">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="9" cy="8" r="4"/><path d="M3 21v-1a6 6 0 0 1 9-5.2"/><circle cx="18" cy="17" r="2.5"/><path d="M18 13v1.5M18 19.5V21M14 17h1.5M20.5 17H22"/></svg>
                            <b>Change role</b><small>Officer, approver or administrator</small>
                        </button>
                        <button type="button" class="action-tile" role="tab" data-tabs-target="tab" data-action="tabs#select">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="8" cy="15" r="4"/><path d="M10.8 12.2L20 3M16 7l3 3M14 9l2 2"/></svg>
                            <b>Reset password</b><small>Temporary password, signs out</small>
                        </button>
                        <button type="button" class="action-tile danger" role="tab" data-tabs-target="tab" data-action="tabs#select">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M5.6 5.6l12.8 12.8"/></svg>
                            <b>Disable</b><small>Blocks sign-in, keeps history</small>
                        </button>
                    {% else %}
                        <button type="button" class="action-tile" role="tab" data-tabs-target="tab" data-action="tabs#select">
                            <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M8 12l3 3 5-6"/></svg>
                            <b>Enable</b><small>Signs in with the current password</small>
                        </button>
                    {% endif %}
                </div>

                <div class="admin-actions">
                    {% if user.locked %}
                        <form autocomplete="off" method="post" action="{{ path('app_admin_user_unlock', {username: user.username}) }}" data-tabs-target="panel" role="tabpanel">
                            <input type="hidden" name="_token" value="{{ csrf_token('user-admin') }}">
                            <b>Unlock</b><small class="muted">Locked after too many failed sign-ins. Unlocking takes effect at once.</small>
                            <button class="button primary small">Unlock now</button>
                        </form>
                    {% endif %}
                    {% if user.active %}
                        <form autocomplete="off" method="post" action="{{ path('app_admin_user_request', {username: user.username}) }}" data-tabs-target="panel" role="tabpanel">
                            <input type="hidden" name="_token" value="{{ csrf_token('user-admin') }}">
                            <input type="hidden" name="type" value="change_role">
                            <b>Change role</b>
                            <select name="role" required aria-label="New role">
                                {% for role in roles|filter(r => r != user.role) %}<option value="{{ role.value }}">{{ role.label }}</option>{% endfor %}
                            </select>
                            <textarea name="reason" rows="1" placeholder="Reason (required)" maxlength="1000" required></textarea>
                            <button class="button outline small">Request role change</button>
                        </form>
                        <form autocomplete="off" method="post" action="{{ path('app_admin_user_request', {username: user.username}) }}" data-tabs-target="panel" role="tabpanel">
                            <input type="hidden" name="_token" value="{{ csrf_token('user-admin') }}">
                            <input type="hidden" name="type" value="reset_password">
                            <b>Reset password</b><small class="muted">Issues a temporary password, unlocks the account and signs it out everywhere.</small>
                            <textarea name="reason" rows="1" placeholder="Reason (required)" maxlength="1000" required></textarea>
                            <button class="button outline small">Request password reset</button>
                        </form>
                        <form autocomplete="off" method="post" action="{{ path('app_admin_user_request', {username: user.username}) }}" data-tabs-target="panel" role="tabpanel">
                            <input type="hidden" name="_token" value="{{ csrf_token('user-admin') }}">
                            <input type="hidden" name="type" value="disable">
                            <b>Disable</b><small class="muted">The person can no longer sign in; their name stays on everything they did.</small>
                            <textarea name="reason" rows="1" placeholder="Reason (required)" maxlength="1000" required></textarea>
                            <button class="button outline small danger">Request disabling</button>
                        </form>
                    {% else %}
                        <form autocomplete="off" method="post" action="{{ path('app_admin_user_request', {username: user.username}) }}" data-tabs-target="panel" role="tabpanel">
                            <input type="hidden" name="_token" value="{{ csrf_token('user-admin') }}">
                            <input type="hidden" name="type" value="enable">
                            <b>Enable</b><small class="muted">Lets the person sign in again with their current password.</small>
                            <textarea name="reason" rows="1" placeholder="Reason (required)" maxlength="1000" required></textarea>
                            <button class="button outline small">Request enabling</button>
                        </form>
                    {% endif %}
                </div>
            {% endif %}
        </section>

        <section class="panel table-panel history" data-controller="tabs">
            <div class="history-tabs" role="tablist">
                <button type="button" role="tab" data-tabs-target="tab" data-action="tabs#select">Change requests <span>{{ requests|length }}</span></button>
                <button type="button" role="tab" data-tabs-target="tab" data-action="tabs#select">Sign-ins and changes <span>{{ audit|length }}</span></button>
            </div>
            <div data-tabs-target="panel" role="tabpanel" aria-label="Change requests">
                <div class="table-wrap">
                    <table>
                        <thead><tr><th>Change</th><th>Requested</th><th>Reason</th><th>Decided</th><th>Status</th></tr></thead>
                        <tbody>
                        {% for change in requests %}
                            <tr>
                                <td>{{ change.describe }}</td>
                                <td>{{ change.requestedAt|date(when) }}<small class="block muted">{{ change.requestedBy }}</small></td>
                                <td>{{ change.reason }}</td>
                                <td>{% if change.reviewedBy %}{{ change.reviewedAt|date(when) }}<small class="block muted">{{ change.reviewedBy }}{{ change.reviewNote ? ' · ' ~ change.reviewNote }}</small>{% else %}<span class="muted">—</span>{% endif %}</td>
                                <td><span class="tag {{ change.status.tone }}">{{ change.status.label }}</span></td>
                            </tr>
                        {% else %}
                            <tr><td colspan="5" class="muted">No change requests (accounts created on the server have none).</td></tr>
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
            <div data-tabs-target="panel" role="tabpanel" aria-label="Audit trail">
                {{ include('admin/_audit_table.html.twig', {entries: audit}) }}
            </div>
        </section>
    </div>
</div>
{% endblock %}
