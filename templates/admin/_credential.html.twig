{# A temporary password, shown once to the administrator who approved the new account or reset. #}
{% for credential in app.flashes('credential') %}
    <section class="panel pad credential" role="status">
        <span class="eyebrow">TEMPORARY PASSWORD · SHOWN ONCE</span>
        <p>Give this password to <b>{{ credential[0] }}</b> in person or by another secure channel. It is not stored anywhere readable and will not be shown again; they must change it when they first sign in.</p>
        <code class="credential-value">{{ credential[1] }}</code>
    </section>
{% endfor %}
