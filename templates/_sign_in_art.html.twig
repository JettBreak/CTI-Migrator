{# The illustration on the right of the corporate theme's sign-in page (templates/_signed_out_layout.html.twig, "plain"
   scenery): a payment card in front of an app window where masked account numbers move from old to new, two done
   and one in progress, and a security shield. Decoration only; styled and animated in theme-corporate.css. #}
<svg class="sign-in-art" viewBox="0 0 520 440" role="presentation" aria-hidden="true" focusable="false">
    <defs>
        <linearGradient id="art-card" x1="0" y1="0" x2="1" y2="1">
            <stop offset="0" stop-color="#2a6fd6"/>
            <stop offset=".55" stop-color="#123a73"/>
            <stop offset="1" stop-color="#0b2545"/>
        </linearGradient>
        <filter id="art-shadow" x="-20%" y="-20%" width="140%" height="150%">
            <feDropShadow dx="0" dy="12" stdDeviation="14" flood-color="#0f1f3a" flood-opacity=".12"/>
        </filter>
    </defs>

    {# Backdrop #}
    <circle cx="290" cy="220" r="190" fill="#eef3fb"/>
    <circle cx="462" cy="86" r="38" fill="#fdf1e1"/>
    <circle cx="70" cy="120" r="14" fill="#e8f0fc"/>

    {# App window: old account → new account, row by row #}
    <g class="art-window" filter="url(#art-shadow)">
        <rect x="150" y="60" width="320" height="236" rx="14" fill="#fff"/>
        <path d="M150 74a14 14 0 0 1 14-14h292a14 14 0 0 1 14 14v20H150z" fill="#f8fafc"/>
        <line x1="150" y1="94" x2="470" y2="94" stroke="#e3e8ef"/>
        <circle cx="172" cy="77" r="4.5" fill="#f1b8c0"/><circle cx="187" cy="77" r="4.5" fill="#f9e3bb"/><circle cx="202" cy="77" r="4.5" fill="#bfe3cc"/>
        <rect x="174" y="112" width="128" height="10" rx="5" fill="#0f1f3a" opacity=".85"/>
        <rect x="174" y="130" width="186" height="7" rx="3.5" fill="#cbd5e1"/>

        {% for row in [{y: 156, state: 'done'}, {y: 194, state: 'done'}, {y: 232, state: 'busy'}] %}
            <g class="art-row art-row-{{ loop.index }}">
                <rect x="174" y="{{ row.y }}" width="94" height="24" rx="12" fill="#f1f5f9"/>
                <text x="221" y="{{ row.y + 16 }}" text-anchor="middle" class="art-mono" fill="#64748b">001-••••</text>
                <path class="art-arrow" d="M274 {{ row.y + 12 }}h26" stroke="#1f5fbf" stroke-width="2" stroke-dasharray="4 4" fill="none"/>
                <path d="M297 {{ row.y + 7 }}l6 5-6 5" stroke="#1f5fbf" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                <rect x="310" y="{{ row.y }}" width="94" height="24" rx="12" fill="#e8f0fc"/>
                <text x="357" y="{{ row.y + 16 }}" text-anchor="middle" class="art-mono" fill="#1a4fa0">009-••••</text>
                {% if row.state == 'done' %}
                    <circle cx="428" cy="{{ row.y + 12 }}" r="10" fill="#15803d"/>
                    <path d="M423.5 {{ row.y + 12 }}l3 3 6-6" stroke="#fff" stroke-width="2.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
                {% else %}
                    <circle cx="428" cy="{{ row.y + 12 }}" r="9" fill="none" stroke="#fde3bf" stroke-width="3"/>
                    <circle class="art-spin" cx="428" cy="{{ row.y + 12 }}" r="9" fill="none" stroke="#f59a23" stroke-width="3" stroke-dasharray="14 43" stroke-linecap="round"/>
                {% endif %}
            </g>
        {% endfor %}
        <rect x="174" y="272" width="230" height="6" rx="3" fill="#e5eaf1"/>
        <rect class="art-progress" x="174" y="272" width="160" height="6" rx="3" fill="#1f5fbf"/>
    </g>

    {# Payment card #}
    <g class="art-card" filter="url(#art-shadow)">
        <rect x="56" y="236" width="236" height="148" rx="16" fill="url(#art-card)"/>
        <text x="80" y="266" class="art-label" fill="#a9c3ea">CORE ACCOUNT</text>
        <rect x="80" y="280" width="36" height="27" rx="5" fill="#f5b955"/>
        <path d="M80 293.5h36M92 280v27M104 280v27" stroke="#d99a3a" stroke-width="1.2"/>
        <path d="M134 286a10 10 0 0 1 0 14M140 282a16 16 0 0 1 0 22" stroke="#cfe0fb" stroke-width="2" fill="none" stroke-linecap="round" opacity=".8"/>
        <text x="80" y="340" class="art-mono art-number" fill="#fff">••••  ••••  ••••  4821</text>
        <circle cx="244" cy="356" r="13" fill="#f59a23" opacity=".95"/>
        <circle cx="262" cy="356" r="13" fill="#fff" opacity=".35"/>
    </g>

    {# Security shield #}
    <g class="art-shield" filter="url(#art-shadow)">
        <path d="M448 270l34 12v24c0 22-15 36-34 42-19-6-34-20-34-42v-24z" fill="#fff"/>
        <path d="M448 282l23 8v16c0 15-10 25-23 29-13-4-23-14-23-29v-16z" fill="#e8f0fc"/>
        <path d="M438 307l7 7 13-14" stroke="#1f5fbf" stroke-width="3.2" fill="none" stroke-linecap="round" stroke-linejoin="round"/>
    </g>
</svg>
