{% extends 'base.html.twig' %}

{% block title %}Change password · Coreware{% endblock %}
{% block crumb %}Change password{% endblock %}

{% block body %}
<section class="page-head compact">
    <div>
        <span class="eyebrow">MY ACCOUNT</span>
        <h1>Change password</h1>
        <p>At least 12 characters with upper- and lower-case letters, a digit and a symbol; not containing your username, and none of your last {{ history }} passwords. Passwords expire after {{ max_age }}.</p>
    </div>
</section>

{% if forced %}
    <p class="exception notice page-notice"><span>!</span> You signed in with a temporary password. Choose your own password to continue.</p>
{% elseif expired %}
    <p class="exception notice page-notice"><span>!</span> Your password is older than {{ max_age }}. Choose a new one to continue.</p>
{% endif %}

<section class="panel pad">
    {{ form_start(form, {attr: {class: 'stack-form', autocomplete: 'off', novalidate: 'novalidate'}}) }}
        {{ form_errors(form) }}
        {% for field in [form.currentPassword, form.newPassword.first, form.newPassword.second] %}
            <div class="field">
                {{ form_label(field) }}
                {{ form_widget(field) }}
                {# The new password's rules are reported on the repeated field; show them under its first input. #}
                {% set errors = loop.index == 2 ?form.newPassword.vars.errors|merge(field.vars.errors) : field.vars.errors %}
                {% if errors|length %}<ul class="form-errors">{% for error in errors %}<li>{{ error.message }}</li>{% endfor %}</ul>{% endif %}
            </div>
        {% endfor %}
        <div class="stack-form-actions">
            <button type="submit" class="button primary small">Change password</button>
        </div>
    {{ form_end(form, {render_rest: true}) }}
</section>
{% endblock %}
