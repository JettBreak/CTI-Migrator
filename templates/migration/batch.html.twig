{% extends 'base.html.twig' %}

{% block title %}Batch #{{ batch.id }} · Coreware{% endblock %}
{% block crumb %}Account replacement <b>/</b> Batch #{{ batch.id }}{% endblock %}

{% block body %}
{% if busy %}<div hidden data-controller="auto-refresh" data-auto-refresh-interval-value="5"></div>{% endif %}
<section class="page-head compact">
    <div>
        <span class="eyebrow">BATCH #{{ batch.id }}</span>
        <h1>{{ batch.filename }}</h1>
        {% if batch.status.value == 'importing' %}
            <p>{{ batch.rowCount|number_format }} rows · validating against core…</p>
        {% else %}
            <p>{{ batch.rowCount|number_format }} rows · {{ batch.accountCount|number_format }} account(s) · {{ batch.validRowCount|number_format }} valid · {{ batch.invalidRowCount|number_format }} need correction</p>
        {% endif %}
    </div>
    <span class="tag {{ batch.status.tone }}">{{ batch.status.label }}</span>
</section>

{% if busy %}
<section class="panel pad processing">
    <div>
        {% if batch.status.value == 'importing' %}
            <h2>Validating rows</h2>
            <p>{{ batch.validatedRowCount|number_format }} of {{ batch.rowCount|number_format }} rows checked against core. This page refreshes every 5 seconds.</p>
        {% elseif batch.status.value == 'rolling_back' %}
            <h2>Rolling back: giving accounts their old numbers back</h2>
            <p>{{ (batch.rolledBackAccountCount + batch.rollbackSkippedCount)|number_format }} of {{ batch.appliedAccountCount|number_format }} account(s) done ({{ batch.rollbackSkippedCount|number_format }} left alone because core changed since). Each chunk commits on its own. This page refreshes every 5 seconds.</p>
        {% else %}
            <h2>Replacing accounts in core</h2>
            <p>{{ batch.appliedAccountCount|number_format }} of {{ batch.accountCount|number_format }} account(s) replaced. Each chunk commits on its own. This page refreshes every 5 seconds.</p>
        {% endif %}
    </div>
    <div class="progress-track"><i style="width: {{ batch.progress }}%"></i></div>
</section>
{% elseif just_finished %}
{# The same section as while busy, so the page's refresh morphs the bar to 100% and the star burns out. #}
<section class="panel pad processing">
    <div>
        <h2>{{ batch.status.value == 'rolled_back' ? 'Rollback finished' : 'Replacement finished' }}</h2>
        <p>{{ batch.status.value == 'rolled_back'
            ? (batch.rolledBackAccountCount|number_format ~ ' account(s) given their old numbers back.')
            : (batch.appliedAccountCount|number_format ~ ' of ' ~ batch.accountCount|number_format ~ ' account(s) replaced.') }}</p>
    </div>
    <div class="progress-track is-done"><i style="width: 100%"></i></div>
</section>
{% if waiting_for_worker %}
<p class="flash error">The background worker is off, so this batch will wait until someone turns it on. <a href="{{ path('app_worker') }}">Open Background worker</a></p>
{% endif %}
{% endif %}

<section class="panel pad">
    <dl class="facts">
        <div><dt>Uploaded</dt><dd>{{ batch.uploadedAt|date('M j, Y H:i') }} by {{ batch.uploadedBy }}</dd></div>
        <div><dt>Submitted</dt><dd>{{ batch.submittedAt ? batch.submittedAt|date('M j, Y H:i') : '—' }}</dd></div>
        <div><dt>Reviewed</dt><dd>{{ batch.reviewedBy ? batch.reviewedAt|date('M j, Y H:i') ~ ' by ' ~ batch.reviewedBy : '—' }}</dd></div>
        <div><dt>Applied</dt><dd>{% if batch.status.value == 'completed' %}{{ batch.processedAt|date('M j, Y H:i') }}{% elseif batch.appliedAccountCount > 0 %}{{ batch.appliedAccountCount|number_format }} of {{ batch.accountCount|number_format }} accounts{% else %}—{% endif %}</dd></div>
    </dl>

    {# Data retention, a fixed rule (App\Service\BatchRowPurger): the rows of Rejected, Invalid and Failed batches are
       permanently deleted 90 days after the batch ended. #}
    {% if rows_purged %}
        <div class="exception"><span>!</span> <div><b>Rows permanently deleted.</b> Under the fixed data-retention rule, the rows of this batch were deleted {{ rows_due_on ? 'on or after ' ~ rows_due_on|date('M j, Y') }}, 90 days after it ended as {{ batch.status.label|lower }}. They cannot be restored. The batch record, its counts and its audit trail are kept. To migrate these accounts, upload the file again.</div></div>
    {% elseif rows_due_on %}
        <div class="exception notice"><span>i</span> <div><b>Data retention:</b> the rows of this batch will be permanently deleted on {{ rows_due_on|date('M j, Y') }}, 90 days after it ended as {{ batch.status.label|lower }}. This is a fixed rule and deleted rows cannot be restored; the batch record, its counts and its audit trail are kept.</div></div>
    {% endif %}
    {% if batch.status.value == 'invalid' and not rows_purged %}
        <p class="exception"><span>!</span> {{ batch.invalidRowCount|number_format }} row(s) need correction. Correct them in your file and upload it again{% if batch.validRowCount > 0 %}, or proceed with the valid rows only: the rows that need correction are skipped{% endif %}.</p>
    {% elseif batch.status.value in ['failed', 'halted', 'rollback_halted'] %}
        <p class="exception"><span>!</span> {{ batch.failureReason }}</p>
    {% elseif batch.status.value == 'rejected' and batch.reviewNote %}
        <p class="exception"><span>!</span> Rejection note: {{ batch.reviewNote }}</p>
    {% elseif batch.status.value in ['processing', 'rolling_back'] %}
        <p class="exception"><span>!</span> If progress stops moving while the worker is on, check core and the logs before doing anything else with this batch.</p>
    {% endif %}
    {% if batch.status.value == 'rollback_requested' %}
        <p class="exception notice"><span>i</span> Rollback requested by {{ batch.rollbackRequestedBy }} on {{ batch.rollbackRequestedAt|date('M j, Y H:i') }}: “{{ batch.rollbackReason }}”. Nothing changes in core until an approver approves it.</p>
    {% elseif batch.status.value == 'rolled_back' %}
        <p class="exception notice"><span>i</span> Rolled back {{ batch.processedAt|date('M j, Y H:i') }} (requested by {{ batch.rollbackRequestedBy }}, approved by {{ batch.rollbackReviewedBy }}): {{ batch.rolledBackAccountCount|number_format }} account(s) have their old number back.
        {% if batch.rollbackSkippedCount > 0 %}{{ batch.rollbackSkippedCount|number_format }} account(s) were left on their new number because core changed since; they are listed with the reason on the <a href="{{ path('app_exports') }}">Exports</a> page.{% endif %}</p>
    {% elseif batch.status.value in ['completed', 'halted'] and batch.rollbackReviewNote %}
        <p class="exception"><span>!</span> Rollback request rejected by {{ batch.rollbackReviewedBy }}: {{ batch.rollbackReviewNote }}</p>
    {% endif %}
    {% if batch.skipsInvalidRows %}
        <p class="exception notice"><span>i</span> Valid rows only: {{ batch.invalidRowCount|number_format }} row(s) that need correction are skipped, together with the other rows of their accounts, and are not replaced.
        {% if batch.status.value in ['completed', 'rollback_requested', 'rolling_back', 'rolled_back', 'rollback_halted'] %}The migrated rows and the rows to correct are exported on the <a href="{{ path('app_exports') }}">Exports</a> page.{% else %}Once the replacement is done, two exports are queued on the Exports page: the migrated rows, and the rows to correct.{% endif %}</p>
    {% endif %}

    <div class="review-actions">
        {% if is_granted('BATCH_SUBMIT', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_submit', {id: batch.id}) }}">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">Submit for approval <span>→</span></button>
            </form>
        {% elseif batch.status.value == 'validated' %}
            <p class="muted">Only {{ batch.uploadedBy }} can submit this batch.</p>
        {% endif %}

        {% if is_granted('BATCH_SUBMIT_VALID', batch) and not rows_purged %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_submit_valid', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Proceed with the {{ batch.validRowCount|number_format }} valid row(s) only?"
                  data-confirm-message-value="The {{ batch.invalidRowCount|number_format }} row(s) that need correction are skipped and not replaced; so are the other rows of their accounts, so that no account is left half-done. An approver still has to approve the rest. Once the replacement is done, two exports are queued on the Exports page: the migrated rows, and the rows to correct (in the upload format, to fix and upload again)."
                  data-confirm-confirm-label-value="Proceed with valid rows">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">Proceed with valid rows only <span>→</span></button>
            </form>
        {% endif %}

        {% if is_granted('BATCH_REVIEW', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_approve', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Approve and replace {{ batch.accountCount|number_format }} account(s)?"
                  data-confirm-message-value="{% if batch.skipsInvalidRows %}Valid rows only: {{ batch.invalidRowCount|number_format }} row(s) that need correction are skipped. {% endif %}The account numbers are replaced in core now, and every linked card follows the new number. Accounts are replaced in chunks; if one chunk fails, the batch stops there and earlier chunks stay replaced.{% if batch.skipsInvalidRows %} Afterwards, exports of the migrated rows and the rows to correct are queued on the Exports page.{% endif %}"
                  data-confirm-confirm-label-value="Approve and replace">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">Approve and replace {{ batch.accountCount|number_format }} account(s) <span>→</span></button>
            </form>
            <form autocomplete="off" method="post" action="{{ path('app_batch_reject', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Reject batch #{{ batch.id }}?"
                  data-confirm-message-value="Nothing is changed in core. {{ batch.uploadedBy }} will need to correct the file and upload it again."
                  data-confirm-confirm-label-value="Reject batch"
                  data-confirm-tone-value="danger">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <textarea name="note" rows="1" placeholder="Reason for rejection (optional)" maxlength="1000"></textarea>
                <button class="button outline">Reject</button>
            </form>
        {% elseif batch.status.value == 'awaiting_approval' %}
            <p class="muted">Waiting for an approver other than {{ batch.uploadedBy }}.</p>
        {% endif %}

        {% if is_granted('BATCH_RESUME', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_resume', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Resume and replace {{ (batch.accountCount - batch.appliedAccountCount)|number_format }} remaining account(s)?"
                  data-confirm-message-value="Every remaining row is checked against live core data again first. Accounts already replaced are not touched."
                  data-confirm-confirm-label-value="Resume">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">Resume: replace remaining {{ (batch.accountCount - batch.appliedAccountCount)|number_format }} account(s) <span>→</span></button>
            </form>
        {% elseif batch.status.value == 'halted' %}
            <p class="muted">An approver other than {{ batch.uploadedBy }} can resume this batch.</p>
        {% endif %}

        {% if is_granted('BATCH_ROLLBACK_REQUEST', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_rollback_request', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Request a rollback of {{ batch.appliedAccountCount|number_format }} account(s)?"
                  data-confirm-message-value="An approver other than you has to approve it. Then every account this batch replaced gets its old number back in core, and its card links are restored. Accounts that changed in core since the replacement are left alone and listed in an export."
                  data-confirm-confirm-label-value="Request rollback"
                  data-confirm-tone-value="danger">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <textarea name="reason" rows="1" placeholder="Reason for the rollback (required)" maxlength="1000" required></textarea>
                <button class="button outline">↩ Request rollback</button>
            </form>
        {% endif %}

        {% if is_granted('BATCH_ROLLBACK_REVIEW', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_rollback_approve', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Approve the rollback of {{ batch.appliedAccountCount|number_format }} account(s)?"
                  data-confirm-message-value="Every account this batch replaced gets its old number back in core now, and each linked card follows. Accounts are rolled back in chunks, each checked against live data first; accounts that changed since are left alone and exported."
                  data-confirm-confirm-label-value="Approve rollback"
                  data-confirm-tone-value="danger">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">↩ Approve rollback</button>
            </form>
            <form autocomplete="off" method="post" action="{{ path('app_batch_rollback_reject', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Reject the rollback request?"
                  data-confirm-message-value="Nothing is changed in core; the batch stays as it is."
                  data-confirm-confirm-label-value="Reject request">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <textarea name="note" rows="1" placeholder="Reason for rejecting (optional)" maxlength="1000"></textarea>
                <button class="button outline">Reject rollback</button>
            </form>
        {% elseif batch.status.value == 'rollback_requested' %}
            <p class="muted">Waiting for an approver other than {{ batch.rollbackRequestedBy }}.</p>
        {% endif %}

        {% if is_granted('BATCH_ROLLBACK_RESUME', batch) %}
            <form autocomplete="off" method="post" action="{{ path('app_batch_rollback_resume', {id: batch.id}) }}"
                  data-controller="confirm" data-action="submit->confirm#ask"
                  data-confirm-title-value="Resume the rollback?"
                  data-confirm-message-value="The accounts not dealt with yet are checked against live core data again and get their old numbers back. Accounts already rolled back are not touched."
                  data-confirm-confirm-label-value="Resume rollback">
                <input type="hidden" name="_token" value="{{ csrf_token('batch-action') }}">
                <button class="button primary">↩ Resume rollback</button>
            </form>
        {% elseif batch.status.value == 'rollback_halted' %}
            <p class="muted">An approver other than {{ batch.rollbackRequestedBy }} can resume the rollback.</p>
        {% endif %}

        {% if batch.status.value in ['completed', 'halted'] %}
            <a class="button primary" href="{{ path('app_batch_report', {id: batch.id}) }}" data-turbo="false">⇩ Export migration report</a>
        {% endif %}
        {% if batch.status.value == 'halted' %}
            <a class="button outline" href="{{ path('app_batch_rows', {id: batch.id, filter: 'pending'}) }}" data-turbo="false">⇩ Rows not replaced yet</a>
        {% endif %}
        {% if not busy and batch.invalidRowCount > 0 %}
            <a class="button outline" href="{{ path('app_batch_rows', {id: batch.id, filter: 'invalid'}) }}" data-turbo="false">⇩ Rows to correct ({{ batch.invalidRowCount|number_format }})</a>
        {% endif %}
    </div>
</section>

<section class="panel table-panel">
    {% if batch.invalidRowCount > 0 %}
    <div class="table-tools">
        <span class="muted">{{ invalid_only ? 'Showing only rows that need correction.' : 'Showing all rows.' }}</span>
        {% if invalid_only %}
            <a href="{{ path('app_batch_show', {id: batch.id}) }}">Show all rows</a>
        {% else %}
            <a href="{{ path('app_batch_show', {id: batch.id, invalid: 1}) }}">Show only rows to correct ({{ batch.invalidRowCount|number_format }})</a>
        {% endif %}
    </div>
    {% endif %}
    <div class="table-wrap">
        <table>
            <thead><tr><th>Line</th><th>Card / cardholder</th><th>Current account</th><th>New account</th><th>Cards affected</th><th>Validation</th></tr></thead>
            <tbody>
            {% for row in rows %}
                <tr>
                    <td class="muted">{{ row.lineNumber }}</td>
                    <td>{% if row.cardRef %}<b class="mono">{{ row.cardDisplay ?? ('ref ' ~ row.cardRef) }}</b><small class="block">{{ row.cardholder ?? '—' }}</small>{% else %}<span class="muted">—</span>{% endif %}</td>
                    <td class="mono">{{ row.currentAccount }}</td>
                    <td class="mono {{ row.valid ? 'good-cell' : '' }}">{{ row.newAccount }}</td>
                    <td>{{ row.linkedCards ?? '—' }}</td>
                    <td>
                        {% if row.rolledBackAt %}
                            <span class="validation-status">↩ Rolled back</span>
                        {% elseif row.rollbackError %}
                            <ul class="row-errors"><li>Not rolled back: {{ row.rollbackError }}</li></ul>
                        {% elseif row.appliedAt %}
                            <span class="validation-status verified">✓ Replaced</span>
                        {% elseif row.valid %}
                            <span class="validation-status verified">✓ Ready to replace</span>
                        {% else %}
                            <ul class="row-errors">{% for error in row.errors %}<li>{{ error }}</li>{% endfor %}</ul>
                        {% endif %}
                    </td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">{{ batch.status.value == 'importing' ? 'Rows appear here as they are validated.' : 'No rows.' }}</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
    {% if page_count > 1 %}
    {% set query = invalid_only ? {id: batch.id, invalid: 1} : {id: batch.id} %}
    <div class="pagination">
        <span>Showing {{ ((page - 1) * per_page + 1)|number_format }}–{{ min(page * per_page, total)|number_format }} of {{ total|number_format }} rows</span>
        <div>
            {% if page > 1 %}<a href="{{ path('app_batch_show', query|merge({page: page - 1})) }}">←</a>{% else %}<button disabled>←</button>{% endif %}
            {% set window_start = max(1, page - 2) %}{% set window_end = min(page_count, page + 2) %}
            {% if window_start > 1 %}<a href="{{ path('app_batch_show', query|merge({page: 1})) }}">1</a>{% if window_start > 2 %}<span>…</span>{% endif %}{% endif %}
            {% for number in window_start..window_end %}<a href="{{ path('app_batch_show', query|merge({page: number})) }}" class="{{ number == page ? 'selected' }}">{{ number }}</a>{% endfor %}
            {% if window_end < page_count %}{% if window_end < page_count - 1 %}<span>…</span>{% endif %}<a href="{{ path('app_batch_show', query|merge({page: page_count})) }}">{{ page_count }}</a>{% endif %}
            {% if page < page_count %}<a href="{{ path('app_batch_show', query|merge({page: page + 1})) }}">→</a>{% else %}<button disabled>→</button>{% endif %}
        </div>
    </div>
    {% endif %}
</section>

<section class="panel pad">
    <span class="eyebrow">AUDIT TRAIL</span>
    <ul class="audit">
        {% for entry in audit %}
            <li><b>{{ entry.action|capitalize }}</b> by {{ entry.actor }} · <span class="muted">{{ entry.createdAt|date('M j, Y H:i:s') }}</span>{% if entry.details %}<small class="block muted">{{ entry.details }}</small>{% endif %}</li>
        {% endfor %}
    </ul>
</section>
{% endblock %}
