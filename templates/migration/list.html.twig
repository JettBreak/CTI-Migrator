{% extends 'base.html.twig' %}{% block page_class %}directory-page{% endblock %}{% block crumb %}{{ title }}{% endblock %}{% block body %}<section class="page-head compact"><div><span class="eyebrow">DATA MANAGEMENT</span><h1>{{ title }}</h1><p>{{ subtitle }}</p></div>{{ include('export/_button.html.twig', {status: type == 'cards' ? status : null, label: '⇩ Export ' ~ (type == 'cards' and status ? status ~ ' ' : '') ~ 'cards'}) }}</section><section class="panel table-panel directory-panel" data-controller="loading" data-action="submit->loading#start click->loading#follow">{{ include("_dino_loading.html.twig", {label: "Loading " ~ (type == "cards" ? "cards" : "accounts") ~ "…"}) }}<div class="table-tools"><form autocomplete="off" method="get" class="search" data-turbo-action="advance" role="search">⌕ <input type="search" name="q" value="{{ q }}" maxlength="100" aria-label="Search {{ type }}" placeholder="Search by customer name, customer ID{{ type == 'cards' ? ', account number or card ref' : ' or account number' }}">{% if status %}<input type="hidden" name="status" value="{{ status }}">{% endif %}</form><form autocomplete="off" method="get" class="filter" data-controller="autosubmit" data-turbo-action="advance"><label>☷ Status {% if q %}<input type="hidden" name="q" value="{{ q }}">{% endif %}<select name="status" data-action="change->autosubmit#submit"><option value="">All statuses</option>{% for label, count in statuses %}<option value="{{ label }}" {{ label == status ? 'selected' }}>{{ label }} ({{ count|number_format }})</option>{% endfor %}</select></label><noscript><button>Apply</button></noscript>{% if status or q %} <a href="{{ path(type == 'cards' ? 'app_cards' : 'app_accounts') }}">Clear</a>{% endif %}</form></div><div class="table-wrap"><table><thead><tr>{% if type == 'cards' %}<th>Card number</th><th>Cardholder</th><th>Customer ID (CIF Seq No.)</th><th>Linked account</th><th>Link validation</th>{% else %}<th>Account number</th><th>Customer</th><th>Customer ID (CIF Seq No.)</th><th>Product</th><th>Balance</th>{% endif %}<th>Status</th><th></th></tr></thead><tbody>{% for row in rows %}<tr>{% if type == 'cards' %}<td class="mono">{{ row.card }}</td><td><b>{{ row.cardholder }}</b></td><td class="muted">{{ row.customer_id }}</td><td class="mono">{{ row.account }}</td><td><span class="{{ row.link_validation|default('Verified') == 'Verified' ? 'text-emerald-700 font-semibold' : 'text-amber-700 font-semibold' }}">{{ row.link_validation|default('Verified') }}</span></td>{% else %}<td class="mono">{{ row.account }}</td><td><b>{{ row.customer }}</b></td><td class="muted">{{ row.customer_id }}</td><td>{{ row.type }}</td><td class="money">{{ row.balance }}</td>{% endif %}<td><span class="{{ row.status == 'Active' ? 'text-emerald-700 font-semibold' : 'text-amber-700 font-semibold' }}">{{ row.status }}</span></td><td class="more">•••</td></tr>{% else %}<tr><td colspan="7" class="muted">{% if search_timed_out %}The search took too long while core is busy; try a longer or more exact term.{% else %}No records{{ q ? ' matching “' ~ q ~ '”' }}{{ status ? ' with status “' ~ status ~ '”' }}.{% endif %}</td></tr>{% endfor %}</tbody></table></div><div class="pagination"><span>Showing {{ total > 0 ? ((page - 1) * per_page) + 1 : 0 }}–{{ min(page * per_page, total) }} of {{ total }} records</span><div>{% set route = type == 'cards' ? 'app_cards' : 'app_accounts' %}{% if page > 1 %}<a href="{{ path(route, {page: page - 1, status: status, q: q}) }}">←</a>{% else %}<button disabled>←</button>{% endif %}{% set window_start = max(1, page - 2) %}{% set window_end = min(page_count, page + 2) %}{% if window_start > 1 %}<a href="{{ path(route, {page: 1, status: status, q: q}) }}">1</a>{% if window_start > 2 %}<span>…</span>{% endif %}{% endif %}{% for number in window_start..window_end %}<a href="{{ path(route, {page: number, status: status, q: q}) }}" class="{{ number == page ? 'selected' }}">{{ number }}</a>{% endfor %}{% if window_end < page_count %}{% if window_end < page_count - 1 %}<span>…</span>{% endif %}<a href="{{ path(route, {page: page_count, status: status, q: q}) }}">{{ page_count }}</a>{% endif %}{% if page < page_count %}<a href="{{ path(route, {page: page + 1, status: status, q: q}) }}">→</a>{% else %}<button disabled>→</button>{% endif %}</div></div></section>{% endblock %}
