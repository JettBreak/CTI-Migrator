{# The rocket swipe that ends the loading overlay right after signing in or out (assets/rocket_swipe.js):
   the pixel rocket, its glowing trail and its sparks, cloned when it plays. In both layouts. A theme without space
   scenery has its own transition instead (AppTheme::transition()), built by the script: data-style="blocks" or "lines". #}
{% if app_theme().transition == 'rocket' %}
<template id="rocket-swipe">
    <div class="rocket-swipe" aria-hidden="true">
        <div class="rocket-swipe-sparks"></div>
        <div class="rocket-swipe-front"><div class="rocket-swipe-seam"></div><div class="rocket-swipe-craft">{{ include('_pixel_rocket.html.twig') }}</div></div>
    </div>
</template>
{% else %}
<template id="rocket-swipe" data-style="{{ app_theme().transition }}"></template>
{% endif %}
