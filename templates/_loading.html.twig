{#
    Loading indicator, in the animation set for everyone in Administration > Settings (loading_animation()):
    a pixel rocket cruising through streaking stars and lifting over an asteroid, or a pixel dinosaur
    running over the ground and jumping a cactus, a console-style NOW LOADING over a block bar filling up, or a
    command-line spinner over a [#####.....] bar counting up to 100%.
    By default it is an overlay card, hidden until its parent gets the "is-loading" class
    (see assets/controllers/loading_controller.js).
    Params:
      label   (optional, default "Loading…")
      compact (optional) small inline version without the card, e.g. inside a table cell
      active  (optional) always shown, e.g. while a background job is running
      hide_label (optional) no visible label; screen readers still announce it
      animation  (optional) an App\Enum\LoadingAnimation to show instead of the setting, e.g. for a preview
#}
{% set animation = animation|default(loading_animation()) %}
<div class="loading-indicator{{ compact|default(false) ? ' compact' }}{{ active|default(false) ? ' is-active' }}" role="status" aria-live="polite" data-animation="{{ animation.value }}">
    <div class="loading-stage" aria-hidden="true">
        {% if animation.value == 'terminal' %}
        <div class="term-cmd"><span class="term-prompt">$</span> fetch --wait <span class="term-spin"></span></div>
        <div class="term-progress">[<span class="term-bar"><span class="term-todo">....................</span><span class="term-done">####################</span></span>] <span class="term-pct"></span></div>
        {% elseif animation.value == 'now-loading' %}
        <div class="nl-text">NOW LOADING<span class="nl-dot">.</span><span class="nl-dot">.</span><span class="nl-dot">.</span></div>
        <div class="nl-bar"><i></i></div>
        {% elseif animation.value == 'dinosaur' %}
        <svg class="dino" viewBox="0 0 24 21" shape-rendering="crispEdges">
            <path d="M14 0h8v1h-8zM13 1h10v1h-10zM13 2h2v1h-2zM16 2h7v1h-7zM13 3h10v1h-10zM13 4h10v1h-10zM13 5h5v1h-5zM13 6h8v1h-8zM1 7h1v1h-1zM12 7h5v1h-5zM1 8h1v1h-1zM11 8h6v1h-6zM1 9h2v1h-2zM10 9h9v1h-9zM1 10h3v1h-3zM9 10h7v1h-7zM17 10h1v1h-1zM1 11h4v1h-4zM7 11h9v1h-9zM1 12h14v1h-14zM2 13h13v1h-13zM3 14h11v1h-11zM4 15h9v1h-9zM5 16h7v1h-7z"/>
            <path class="dino-legs-a" d="M5 17h3v1h-3zM9 17h2v1h-2zM5 18h2v1h-2zM10 18h2v1h-2zM5 19h1v1h-1zM5 20h2v1h-2z"/>
            <path class="dino-legs-b" d="M5 17h2v1h-2zM9 17h3v1h-3zM4 18h2v1h-2zM9 18h2v1h-2zM9 19h1v1h-1zM9 20h2v1h-2z"/>
        </svg>
        <svg class="dino-cactus" viewBox="0 0 7 12" shape-rendering="crispEdges">
            <path d="M3 0h1v1h-1zM2 1h3v1h-3zM2 2h3v1h-3zM6 2h1v1h-1zM0 3h1v1h-1zM2 3h3v1h-3zM6 3h1v1h-1zM0 4h1v1h-1zM2 4h3v1h-3zM6 4h1v1h-1zM0 5h1v1h-1zM2 5h5v1h-5zM0 6h1v1h-1zM2 6h3v1h-3zM0 7h5v1h-5zM2 8h3v1h-3zM2 9h3v1h-3zM2 10h3v1h-3zM2 11h3v1h-3z"/>
        </svg>
        <div class="dino-ground"></div>
        {% else %}
        <div class="rocket-streaks"></div>
        <svg class="rocket-asteroid" viewBox="0 0 6 5" shape-rendering="crispEdges">
            <path d="M1 0h3v1h-3zM0 1h5v1h-5zM0 2h6v1h-6zM1 3h5v1h-5zM2 4h2v1h-2z"/>
            <path class="rocket-crater" d="M2 1h1v1h-1zM3 3h1v1h-1z"/>
        </svg>
        <div class="rocket-craft">{{ include('_pixel_rocket.html.twig') }}</div>
        {% endif %}
    </div>
    <span class="loading-label{{ hide_label|default(false) ? ' visually-hidden' }}">{{ label|default('Loading…') }}</span>
</div>
