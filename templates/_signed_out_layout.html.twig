{# Shell of the signed-out pages (sign-in, error pages): the space background with the globe, header and footer. #}
<!DOCTYPE html>
<html lang="en" class="page-loading" data-controller="page-loader" data-page-loader-wait-for-value="login-globe:ready">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}{% endblock %} · Coreware Migration</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/logo-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/logo-256.png') }}">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=JetBrains+Mono:wght@500;600&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {{ importmap('app') }}
</head>
<body class="login-page min-h-screen flex flex-col antialiased">
<style>
    .login-page{background:
        radial-gradient(ellipse 45% 55% at 88% 18%,rgba(124,77,219,.45),transparent 70%),
        radial-gradient(ellipse 40% 50% at 62% 88%,rgba(48,104,219,.45),transparent 70%),
        radial-gradient(ellipse 30% 35% at 98% 85%,rgba(245,154,35,.18),transparent 70%),
        radial-gradient(ellipse 35% 45% at 8% 20%,rgba(48,104,219,.28),transparent 70%),
        radial-gradient(ellipse 30% 40% at 25% 95%,rgba(124,77,219,.25),transparent 70%),
        radial-gradient(circle at 75% 50%,#0c1f45,#050b1c 80%) fixed}
    /* Header and footer sit directly on the space scene, with light text */
    .login-bar{position:relative;z-index:1;border:0;background:transparent}
    header.login-bar{height:auto}

    /* Fit the window without a scrollbar: spacing and type scale with the window height (vh), so the
       page fits common laptop and desktop screens. A window too short for it still scrolls (wheel,
       keyboard, touch) with the scrollbar hidden, rather than cutting off the form. */
    html:has(body.login-page){height:100%;overflow:hidden}
    body.login-page{height:100vh;height:100dvh;min-height:0;overflow-y:auto;scrollbar-width:none}
    body.login-page::-webkit-scrollbar{display:none}
    .login-page header.login-bar{padding-block:clamp(8px,2.2vh,20px)}
    .login-page .brand-logo{width:clamp(30px,5.2vh,50px);height:clamp(30px,5.2vh,50px)}
    .login-page .brand-name{font-size:clamp(17px,3vh,28px)}
    /* Grows to fill the window, but never shrinks below its content (the page scrolls instead). */
    .login-page>main{padding-block:clamp(6px,2.4vh,40px);flex:1 0 auto;min-height:auto!important}
    /* The content's indent from the left: 160px on wide screens, shrinking as the window narrows
       (none below about 940px), so the form stays clear of the globe on the right. */
    .login-page .content-column{padding-left:clamp(0px,59.7vw - 560px,160px)}
    .login-page>main h1{font-size:clamp(26px,5vh,48px);margin-bottom:clamp(6px,1.4vh,16px)}
    .login-page>main .mb-5{margin-bottom:clamp(8px,1.8vh,20px)}
    .login-page>main .space-y-4>:not([hidden])~:not([hidden]){margin-top:clamp(6px,1.4vh,16px)}
    .login-page>main label>input:not([type=radio]),.login-page>main label>textarea{padding-block:clamp(5px,1vh,10px);margin-top:clamp(3px,.6vh,6px)}
    .login-page>main .button.h-12{height:clamp(36px,5vh,48px)}
    .login-page .lock-choice{min-height:clamp(32px,4.4vh,40px)}
    .login-page .login-safeguards{padding-bottom:clamp(6px,2.4vh,32px)}
    .login-page .login-safeguards>ul{padding-top:clamp(8px,2vh,24px)}
    .login-page>footer.login-bar{padding-block:clamp(5px,1.4vh,16px)}
    /* Short windows: the safeguards keep only their titles, then give way to the form. */
    @media (max-height:820px){.login-page .login-safeguards li span.block{display:none}}
    @media (max-height:680px){.login-page .login-safeguards{display:none}}
    /* Super user name and password side by side where there is room. */
    /* "Scroll to explore" (sign-in page): fades out once the wheel has been used (login-globe controller) */
    .zoom-hint{position:fixed;right:clamp(16px,3vw,40px);bottom:clamp(58px,9vh,84px);z-index:1;display:flex;align-items:center;gap:8px;
        font-size:12px;font-weight:600;color:#8ea7cf;pointer-events:none;transition:opacity .8s ease}
    .zoom-hint.is-used{opacity:0}
    @media (max-width:900px),(max-height:560px){.zoom-hint{display:none}}
    /* Console details (sign-in page): the kicker above the heading and the live clock under the badge. */
    .console-kicker{font-family:"JetBrains Mono",ui-monospace,monospace;font-size:clamp(10px,1.4vh,12px);font-weight:500;letter-spacing:.12em;color:#8fc0ff;margin-bottom:clamp(6px,1.4vh,14px)}
    .console-kicker span{color:#f5c98a}
    .console-clock{position:absolute;top:100%;right:clamp(24px,2.5vw,40px);text-align:right;font-family:"JetBrains Mono",ui-monospace,monospace;pointer-events:none}
    .console-clock b{display:block;font-size:clamp(18px,3vh,28px);font-weight:600;color:#fff;letter-spacing:.02em;line-height:1.1;font-variant-numeric:tabular-nums}
    .console-clock span{font-size:11px;font-weight:500;letter-spacing:.06em;color:#8ea7cf}
    @media (max-width:900px),(max-height:560px){.console-clock{display:none}}
    .cred-grid{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px}
    @media (max-width:480px){.cred-grid{grid-template-columns:minmax(0,1fr)}}
</style>
{% block stylesheets %}{% endblock %}
<div class="page-loader solid">{% include '_dino_loading.html.twig' with {active: true, label: 'Loading resources…'} %}</div>
<canvas data-controller="login-globe" data-login-globe-land-value="{{ asset('data/land-110m.json') }}" {% block globe_attributes %}{% endblock %} aria-hidden="true" class="fixed inset-0 w-full h-full -z-10 pointer-events-none"></canvas>
<header class="login-bar py-5 flex items-center gap-3.5 sm:gap-5 px-6 sm:px-10">
    <img src="{{ asset('images/logo-256.png') }}" alt="" width="50" height="50" class="brand-logo shrink-0" style="filter:drop-shadow(0 0 10px rgba(245,154,35,.55))">
    <span class="brand-name leading-tight" style="font-family:Manrope,sans-serif;font-weight:800;letter-spacing:-.5px;color:#fff;text-shadow:0 0 22px rgba(120,170,255,.45)">Coreware Technologies Inc.</span>
    <span class="ml-auto inline-flex items-center gap-2 text-xs font-semibold rounded-md px-2.5 py-1" style="background:var(--green-bg);color:var(--green);border:1px solid rgba(22,135,101,.2)"><span class="live-dot" style="margin:0"></span>Secure environment</span>
    {% block header_status %}{% endblock %}
</header>
{% block body %}{% endblock %}
<footer class="login-bar w-full px-6 sm:px-10 py-4 flex flex-col sm:flex-row gap-1 sm:items-center text-xs" style="color:#8ea7cf">
    <span>© {{ 'now'|date('Y') }} Coreware Technologies Inc. All rights reserved.</span>
    <span class="sm:ml-auto">Authorized personnel only · activity is logged · v1.0</span>
</footer>
</body>
</html>
