<!DOCTYPE html>
<html lang="en" class="page-loading" data-controller="page-loader" data-page-loader-arrival-value="app">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>{% block title %}Coreware Migration{% endblock %}</title>
    <link rel="icon" type="image/png" sizes="32x32" href="{{ asset('images/logo-32.png') }}">
    <link rel="apple-touch-icon" href="{{ asset('images/logo-256.png') }}">
    {# Light or dark before the first paint, so no page flashes the other theme: the theme switch's choice
       (localStorage "theme"), else the browser setting. assets/controllers/theme_controller.js keeps it current. #}
    <script>
        (function () {
            var choice = null;
            try { choice = localStorage.getItem('theme'); } catch (e) {}
            var dark = choice === 'dark' || (choice !== 'light' && window.matchMedia('(prefers-color-scheme: dark)').matches);
            document.documentElement.dataset.theme = dark ? 'dark' : 'light';
        })();
    </script>
    {# Arriving from the sign-in page with a rocket swipe on its way (assets/rocket_swipe.js, the note's "app" and
       30 seconds match it): keep the loading overlay solid, so nothing of this page shows until the rocket
       wipes the overlay away. The page loader takes "swipe-pending" off again. #}
    <script>
        (function () {
            try {
                var note = JSON.parse(sessionStorage.getItem('rocket-swipe') || 'null');
                if (note && note.to === 'app' && Date.now() - note.at < 30000 && !window.matchMedia('(prefers-reduced-motion: reduce)').matches) {
                    document.documentElement.classList.add('swipe-pending');
                }
            } catch (e) {}
        })();
    </script>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@600;700;800&display=swap" rel="stylesheet">
    <script src="https://cdn.tailwindcss.com"></script>
    <script>
        tailwind.config = {
            // dark: utilities follow the theme switch (<html data-theme>), like app.css.
            darkMode: ['selector', '[data-theme="dark"]'],
            theme: {
                extend: {
                    colors: { axiom: { 50: '#eef4ff', 100: '#dce9ff', 500: '#3068db', 700: '#1f4fae', 900: '#10264e' } },
                    fontFamily: { sans: ['DM Sans', 'sans-serif'], display: ['Manrope', 'sans-serif'] }
                }
            }
        }
    </script>
    <link rel="stylesheet" href="{{ asset('styles/app.css') }}">
    {% block importmap %}{{ importmap('app') }}{% endblock %}
    {# Same-page refreshes (e.g. auto-refresh) update the page in place and keep the scroll position. #}
    <meta name="turbo-refresh-method" content="morph">
    <meta name="turbo-refresh-scroll" content="preserve">
</head>
<body class="antialiased {% block page_class %}{% endblock %}">
{# Same label as the sign-in page's overlay, so the card does not change as a sign-in lands here. #}
<div class="page-loader">{% include '_loading.html.twig' with {active: true, label: 'Loading resources…'} %}</div>
{{ include('_rocket_swipe.html.twig') }}<aside class="sidebar shadow-2xl shadow-slate-900/20">
    {# Permanent: Turbo's morphing refresh would otherwise reset the canvas size the controller sets, stretching the stars. #}
    <canvas id="sidebar-stars" class="sidebar-stars" data-controller="starfield" data-turbo-permanent aria-hidden="true"></canvas>
    {% set route = app.request.attributes.get('_route') %}
    <a class="brand" href="{{ path('app_home') }}"><img class="brand-logo" src="{{ asset('images/logo-64.png') }}" alt="" width="36" height="36"><span>Coreware<small>data migration</small></span></a>
    <nav>
        {% if is_granted('ROLE_MIGRATION_OFFICER') %}
        <a href="{{ path('app_dashboard') }}" class="{{ route == 'app_dashboard' ? 'active' }}"><span>▦</span> Overview</a>
        <p>DATA MANAGEMENT</p>
        <a href="{{ path('app_cards') }}" class="{{ route == 'app_cards' ? 'active' }}"><span>▣</span> Card directory</a>
        <a href="{{ path('app_accounts') }}" class="{{ route == 'app_accounts' ? 'active' }}"><span>◫</span> Account directory</a>
        <p>MIGRATION</p>
        <a href="{{ path('app_migration') }}" class="{{ route matches '/^app_(migration|batch_)/' ? 'active' }}"><span>⇄</span> Account replacement</a>
        <a href="{{ path('app_exports') }}" class="{{ route starts with 'app_export' ? 'active' }}"><span>⇩</span> Exports</a>
        <p>OPERATIONS</p>
        <a href="{{ path('app_worker') }}" class="{{ route starts with 'app_worker' ? 'active' }}"><span>⚙</span> Background worker</a>
        {% endif %}
        {% if is_granted('ROLE_USER_ADMIN') %}
        <p>ADMINISTRATION</p>
        <a href="{{ path('app_admin_users') }}" class="{{ route matches '/^app_admin_(users?|user_new)$/' ? 'active' }}"><span>☺</span> Users</a>
        <a href="{{ path('app_admin_audit') }}" class="{{ route == 'app_admin_audit' ? 'active' }}"><span>☰</span> Account audit trail</a>
        <a href="{{ path('app_admin_settings') }}" class="{{ route == 'app_admin_settings' ? 'active' }}"><span>⚙</span> Settings</a>
        {% endif %}
        {% if app.user %}
        <p>MY ACCOUNT</p>
        <a href="{{ path('app_account_password') }}" class="{{ route == 'app_account_password' ? 'active' }}"><span>⚿</span> Change password</a>
        {% endif %}
    </nav>
    <div class="sidebar-footer"><span class="live-dot"></span> Secure environment<br><small>v1.0</small></div>
</aside>
{# Faint stars and shooting stars behind the page in the dark theme; idle in light (starfield controller, dark-only). #}
<canvas id="page-stars" class="page-stars" data-controller="starfield" data-starfield-dark-only-value="true" data-starfield-count-value="160" data-starfield-seed-value="20260929"
        data-starfield-meteors-value='{"gap": [0.6, 2], "max": 3, "distance": [220, 420], "tail": [60, 130]}' data-turbo-permanent aria-hidden="true"></canvas>
<main>
    <header>
        <div class="crumb">Operations <b>/</b> {% block crumb %}Overview{% endblock %}</div>
        <div class="header-tools">
        <div class="theme-switch" data-controller="theme" role="group" aria-label="Theme">
            <button type="button" data-theme-target="option" data-action="theme#choose" data-theme-choice-param="system" aria-pressed="true" title="System: follow the browser setting" aria-label="System theme">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><rect x="3" y="4" width="18" height="12" rx="2"/><path d="M8 20h8M12 16v4"/></svg>
            </button>
            <button type="button" data-theme-target="option" data-action="theme#choose" data-theme-choice-param="light" aria-pressed="false" title="Light" aria-label="Light theme">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            </button>
            <button type="button" data-theme-target="option" data-action="theme#choose" data-theme-choice-param="dark" aria-pressed="false" title="Dark" aria-label="Dark theme">
                <svg width="15" height="15" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
            </button>
        </div>
        {% if app.user %}
            {% set me = app.user %}
            {# The sign-in before this one, so the user can spot one that was not theirs. #}
            {% set previous = me.previousLoginAt ? 'Previous sign-in ' ~ me.previousLoginAt|date('M j, Y H:i') ~ (me.previousLoginIp ? ' from ' ~ me.previousLoginIp : '') : 'First sign-in' %}
            <div class="profile" title="{{ previous }}"><div class="avatar">{{ me.displayName|split(' ')|map(p => p|first)|join|slice(0, 2)|upper }}</div><div><b>{{ me.displayName }}</b><small>{{ me.username }} · {{ me.role.label }} · <a href="{{ logout_path() }}" data-turbo="false" data-controller="rocket-swipe" data-action="rocket-swipe#depart" data-rocket-swipe-to-param="sign-in" data-rocket-swipe-loader-param="true">Sign out</a></small><small class="profile-last">{{ previous }}</small></div></div>
        {% endif %}
        </div>
    </header>
    {% set system_lock_status = system_lock() %}
    {% if system_lock_status.scheduled %}
        {# Timed system lock set by the super user (see App\Security\SystemLock) #}
        <div class="lock-banner{{ system_lock_status.daysLeft <= 3 ? ' urgent' }}" role="status">
            <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true"><circle cx="12" cy="12" r="9"/><path d="M12 7v5l3 2"/></svg>
            <span>Access to data migration ends on <b>{{ system_lock_status.locksAt|date('M j, Y H:i') }}</b> · {{ system_lock_status.daysLeft }} day{{ system_lock_status.daysLeft == 1 ? '' : 's' }} left</span>
        </div>
    {% endif %}
    {% for type, messages in app.flashes(['success', 'error']) %}{% for message in messages %}<div class="flash {{ type }}" role="status">{{ message }}</div>{% endfor %}{% endfor %}
    {% block body %}{% endblock %}
</main>
</body>
</html>