{% extends 'base.html.twig' %}

{% block title %}Exports · Coreware{% endblock %}
{% block crumb %}Exports{% endblock %}

{% block body %}
{% if refresh %}<div hidden data-controller="auto-refresh" data-auto-refresh-interval-value="5"></div>{% endif %}
<section class="page-head compact">
    <div>
        <span class="eyebrow">DATA MANAGEMENT</span>
        <h1>Exports</h1>
        <p>Card exports over {{ sync_max_rows|number_format }} rows are prepared in the background.{% if refresh %} This page refreshes every 5 seconds while one is running.{% endif %}</p>
    </div>
    {{ include('export/_button.html.twig', {label: '⇩ Export all cards'}) }}
</section>

{% if not worker_on and refresh %}
<p class="flash error">The background worker is off — queued exports won't start until it is turned on. <a href="{{ path('app_worker') }}">Open Background worker</a></p>
{% endif %}

<section class="panel table-panel">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Export</th><th>Cards</th><th>Requested</th><th>Progress</th><th>Status</th><th></th></tr></thead>
            <tbody>
            {% for job in jobs %}
                <tr>
                    <td><b>#{{ job.id }}</b></td>
                    <td>{{ job.statusFilter ?? 'All statuses' }}{% if job.state.value == 'completed' and job.finishedAt %}<small class="block muted">file kept until {{ job.finishedAt|date_modify('+' ~ retention)|date('M j, H:i') }}</small>{% endif %}</td>
                    <td>{{ job.createdAt|date('M j, Y H:i') }}<small class="block muted">{{ job.requestedBy }}</small></td>
                    <td>
                        {% if job.state.value == 'running' or job.state.value == 'queued' %}
                            {{ job.cardsWritten|number_format }} / ~{{ job.expectedCards|number_format }} cards
                        {% elseif job.cardsWritten > 0 %}
                            {{ job.cardsWritten|number_format }} cards<small class="block muted">{{ job.rowsWritten|number_format }} rows (one per linked account)</small>
                        {% else %}
                            {{ job.rowsWritten|number_format }} rows
                        {% endif %}
                        {% if not job.state.finished %}<div class="progress-track"><i style="width: {{ job.progress }}%"></i></div>{% endif %}
                    </td>
                    <td><span class="tag {{ job.state.tone }}">{{ job.state.label }}</span>{% if job.error %}<small class="block muted">{{ job.error }}</small>{% endif %}</td>
                    <td>{% if available[job.id] %}<a class="button primary small" href="{{ path('app_export_download', {id: job.id}) }}" data-turbo="false">⇩ Download</a>{% elseif job.state.value == 'running' %}<span class="button small download-pending" aria-disabled="true">{{ include('_dino_loading.html.twig', {label: 'Preparing export…', compact: true, active: true, hide_label: true}) }}</span>{% elseif job.state.value == 'completed' %}<span class="muted">File no longer available</span>{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">No background exports yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
