{% extends 'base.html.twig' %}

{% block title %}Exports · Coreware{% endblock %}
{% block crumb %}Exports{% endblock %}

{% block body %}
{% if refresh %}<div hidden data-controller="auto-refresh" data-auto-refresh-interval-value="{{ refresh_every }}"></div>{% endif %}
<section class="page-head compact">
    <div>
        <span class="eyebrow">DATA MANAGEMENT</span>
        <h1>Exports</h1>
        <p>Card exports over {{ sync_max_rows|number_format }} rows are prepared in the background.{% if refresh %}{% if refresh_every > 5 %} Waiting for a held export: this page refreshes again when it is retried.{% else %} This page refreshes every 5 seconds while one is running.{% endif %}{% endif %}</p>
    </div>
    {{ include('export/_button.html.twig', {label: '⇩ Export all cards'}) }}
</section>

{% if not worker_on and refresh %}
<p class="flash error">The background worker is off — queued exports won't start until it is turned on. <a href="{{ path('app_worker') }}">Open Background worker</a></p>
{% endif %}

<section class="panel table-panel">
    <div class="table-wrap">
        <table>
            <thead><tr><th>Export</th><th>Cards</th><th>Requested</th><th>Progress</th><th>Status</th><th></th></tr></thead>
            <tbody>
            {% for job in jobs %}
                <tr>
                    <td><b>#{{ job.id }}</b></td>
                    <td>{% if job.kind.batchReport %}{{ job.kind.label }} · <a href="{{ path('app_batch_show', {id: job.batch.id}) }}">batch #{{ job.batch.id }}</a>{% else %}{{ job.statusFilter ?? 'All statuses' }}{% endif %}{% if job.state.value == 'completed' and job.finishedAt %}<small class="block muted">file kept until {{ job.finishedAt|date_modify('+' ~ retention)|date('M j, H:i') }}</small>{% endif %}</td>
                    <td>{{ job.createdAt|date('M j, Y H:i') }}<small class="block muted">{{ job.requestedBy }}</small></td>
                    <td>
                        {% if job.kind.batchReport %}
                            {{ job.rowsWritten|number_format }} / {{ job.expectedCards|number_format }} rows
                        {% elseif job.state.value == 'running' or job.state.value == 'queued' %}
                            {{ job.cardsWritten|number_format }} / ~{{ job.expectedCards|number_format }} cards
                        {% elseif job.cardsWritten > 0 %}
                            {{ job.cardsWritten|number_format }} cards<small class="block muted">{{ job.rowsWritten|number_format }} rows (one per linked account)</small>
                        {% else %}
                            {{ job.rowsWritten|number_format }} rows
                        {% endif %}
                        {% if not job.state.finished %}<div class="progress-track slim"><i style="width: {{ job.progress }}%"></i></div>
                        {% elseif finished_for[job.id] is defined %}<div class="progress-track slim is-done leaves-after" style="--leave-after: {{ finished_for[job.id] }}s"><i style="width: 100%"></i></div>{% endif %}
                    </td>
                    <td><span class="tag {{ job.state.tone }}">{{ job.state.label }}</span>{% if job.error %}<small class="block muted">{{ job.error }}</small>{% endif %}{% if held[job.id] is defined %}<small class="block muted" title="A worker took this export and stopped before starting it. To get the file sooner, request the export again.">Held by a stopped worker · retried at {{ held[job.id]|date('H:i') }}</small>
                        {#- Why a queued export has not started: exports are prepared one at a time, by their own worker. #}
                        {%- elseif job.state.value == 'queued' %}<small class="block muted export-wait">{% if not worker_on %}Waiting for the background worker to be turned on{% elseif running_export and running_export.id != job.id %}Waiting for export #{{ running_export.id }} to finish{% else %}Starting shortly{% endif %}</small>{% endif %}</td>
                    <td>{% if available[job.id] %}<a class="button primary small" href="{{ path('app_export_download', {id: job.id}) }}" data-turbo="false">⇩ Download</a>{% elseif job.state.value == 'running' %}<span class="button small download-pending" aria-disabled="true">{{ include('_loading.html.twig', {label: 'Preparing export…', compact: true, active: true, hide_label: true}) }}</span>{% elseif job.state.value == 'completed' %}<span class="muted">File no longer available</span>{% endif %}</td>
                </tr>
            {% else %}
                <tr><td colspan="6" class="muted">No background exports yet.</td></tr>
            {% endfor %}
            </tbody>
        </table>
    </div>
</section>
{% endblock %}
